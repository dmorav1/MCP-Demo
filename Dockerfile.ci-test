FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for caching
COPY requirements.txt .
COPY pytest.ini .

# Install dependencies (continue on error for optional packages)
RUN pip install --no-cache-dir -r requirements.txt 2>/dev/null || true

# Install test dependencies
RUN pip install --no-cache-dir pytest pytest-cov pytest-asyncio pytest-timeout

# Copy application code explicitly (not using COPY . which respects .dockerignore)
COPY app/ ./app/

# Copy slack module
COPY slack/ ./app/slack/

# Copy tests directory explicitly
COPY tests/ ./tests/

# Set environment variables
ENV DATABASE_URL=postgresql://postgres:postgres@ci-test-postgres:5432/test_db
ENV OPENAI_API_KEY=sk-test-key
ENV ANTHROPIC_API_KEY=test-key
ENV PYTHONPATH=/app

CMD ["pytest", "tests/", "-v", "--tb=short", "-m", "not slow and not integration", "--timeout=60", "-x"]
